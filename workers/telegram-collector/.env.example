# Worker de Telegram - Variables de entorno
# Copia este archivo a .env y completa los valores
# NUNCA commits .env al repositorio

# =========================================================================
# Telegram API (obtener en https://my.telegram.org/apps)
# =========================================================================
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_STRING_SESSION=1AgAOMTQ5LjE1ND... (cadena larga generada con generate_session.py)
# Opcional: si falta, generate_session.py pide el teléfono por consola
# TELEGRAM_PHONE=+535XXXXXXXX

# =========================================================================
# Supabase
# =========================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=external-imports

# =========================================================================
# API de ingesta (/api/ingest/external-post)
# =========================================================================
INGEST_API_URL=https://tu-dominio.vercel.app/api/ingest/external-post
INGEST_HMAC_SECRET=clave-secreta-compartida-32-chars-minimo

# =========================================================================
# Opcionales (tienen valores por defecto seguros)
# =========================================================================
MAX_IMAGE_SIZE_BYTES=8388608
MAX_CONSECUTIVE_ERRORS=5
# Solo se importan avisos publicados dentro de esta ventana (días)
MAX_POST_AGE_DAYS=30
# Toda publicación importada debe llevar foto
REQUIRE_IMAGE=true
LOG_LEVEL=INFO