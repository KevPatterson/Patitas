# ── CLIENTE (Vite - expuestas al navegador, seguras con RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://patitass.vercel.app

# Feature Flags (cliente - habilitan UI/features experimentales)
VITE_FACEBOOK_ADAPTER_ENABLED=false
VITE_INGEST_AUTOPUBLISH=false
VITE_SEMANTIC_SEARCH_ENABLED=false
VITE_VISUAL_MATCHING_ENABLED=false
VITE_REAL_OCR_ENABLED=false
# IA en la UI (coincidencias, duplicados, autocompletado por OCR).
# Desactivada por defecto: con AI_PROVIDER=MOCK los resultados son inventados y no
# deben presentarse como reales (tarea 5.4). Ponla a true solo con proveedor real.
VITE_AI_ENABLED=false

# ── SERVIDOR (Vercel Functions - NUNCA con prefijo VITE_) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# LEGADO (sin uso en el código): mantenida solo por compatibilidad con
# despliegues antiguos. Los JWT se verifican contra Supabase Auth.
# SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# ── Rate limiting distribuido (RECOMENDADO en producción) ────────
# Sin estas variables, el límite de /api se lleva en memoria por instancia:
# el límite real es "límite × nº de instancias" y se reinicia en cada arranque.
# Con Upstash (o Vercel KV) el contador es único y atómico.
#
# VÍA RECOMENDADA (en uso en este proyecto): Vercel Marketplace.
#   Dashboard → Storage → Upstash for Redis → conectar al proyecto.
#   Vercel inyecta automáticamente KV_REST_API_URL y KV_REST_API_TOKEN
#   en Production y Preview; no hace falta escribirlas aquí.
#   Verificación: cabecera X-RateLimit-Backend: redis en cualquier /api/*.
#
# Alternativa manual con cuenta de Upstash (https://console.upstash.com):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── OTP por SMS (Send SMS Hook de Supabase + gateway TextBee) ────
# Supabase llama a /api/sms-hook por cada OTP telefonico; el endpoint
# reenvia el codigo al gateway de TextBee (telefono Android con SIM
# cubana). Secreto exacto: Authentication > Hooks en el panel de Supabase.
# Para rotacion, separar secretos con "|" (formato Standard Webhooks).
SEND_SMS_HOOK_SECRETS=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Opcional; por defecto https://api.textbee.dev/api/v1
# TEXTBEE_BASE_URL=

# ── IA (proveedor + feature flag) ────────────────────────────────
# AI_PROVIDER: MOCK | TESSERACT | GOOGLE_VISION | CLOUDFLARE | OPENAI
#   MOCK          → datos de demostración, SIN coste. Es el valor por defecto.
#   TESSERACT     → requiere `npm install tesseract.js` (NO incluido); si no está
#                   instalado, la API responde 503 AI_PROVIDER_UNAVAILABLE.
#   GOOGLE_VISION → OCR + Computer Vision reales (requiere credenciales abajo).
#   CLOUDFLARE    → OCR/vision mediante Workers AI (requiere cuenta/token).
#   OPENAI        → pendiente de implementar.
AI_PROVIDER=MOCK

# AI_ENABLED=false desactiva por completo los endpoints de IA (responden 503).
# Mientras el proveedor sea MOCK, las respuestas incluyen provider_is_real=false
# y la UI debe marcar los resultados como demostración (Fase 5).
AI_ENABLED=true

# Tesseract.js (gratuito, OCR local) — hay que instalar la dependencia:
#   npm install tesseract.js
# Sin ella, AI_PROVIDER=TESSERACT no funciona.

# Google Cloud Vision (GRATUITO hasta 1000 req/mes)
# Obtener credenciales: https://console.cloud.google.com/apis/credentials
# 1. Crear proyecto en Google Cloud
# 2. Activar Cloud Vision API
# 3. Crear Service Account
# 4. Descargar JSON de credenciales
# 5. Copiar el contenido completo del JSON aquí (una sola línea)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Cloudflare AI (si AI_PROVIDER=CLOUDFLARE)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI (si AI_PROVIDER=OPENAI - futuro)
OPENAI_API_KEY=

# Internal API Key (para workers/cron)
INTERNAL_API_KEY=

# ── Ingesta externa ──────────────────────────────────────────────
# Secreto HMAC para autenticar worker de Telegram (generar: openssl rand -hex 32)
INGEST_HMAC_SECRET=

# Auto-publicación de posts importados (requiere fuente trusted + confidence >= 0.85 + imagen + ubicación)
INGEST_AUTOPUBLISH=false
AUTOPUBLISH_CONFIDENCE_THRESHOLD=0.85
AUTOPUBLISH_REQUIRE_TRUSTED_SOURCE=true
AUTOPUBLISH_REQUIRE_IMAGE=true
AUTOPUBLISH_REQUIRE_LOCATION=true

# Feature flag para adaptador Facebook Público (best-effort, solo metadatos OG)
FACEBOOK_ADAPTER_ENABLED=false

# ── DB pooling (solo servidor, opcional) ─────────────────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=