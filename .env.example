# ── CLIENTE (Vite - expuestas al navegador, seguras con RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://patitass.vercel.app

# Feature Flags (cliente - habilitan UI/features experimentales)
VITE_FACEBOOK_ADAPTER_ENABLED=false
VITE_INGEST_AUTOPUBLISH=false
VITE_SEMANTIC_SEARCH_ENABLED=false
VITE_VISUAL_MATCHING_ENABLED=false
VITE_REAL_OCR_ENABLED=false

# ── SERVIDOR (Vercel Functions - NUNCA con prefijo VITE_) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# ── IA Provider (elegir uno) ─────────────────────────────────────
AI_PROVIDER=TESSERACT # TESSERACT | GOOGLE_VISION | CLOUDFLARE | OPENAI | MOCK

# Tesseract.js (GRATUITO, sin límites, OCR local)
# No requiere configuración adicional - funciona out-of-the-box
# ✅ Perfecto para desarrollo y producción pequeña

# Google Cloud Vision (GRATUITO hasta 1000 req/mes)
# Obtener credenciales: https://console.cloud.google.com/apis/credentials
# 1. Crear proyecto en Google Cloud
# 2. Activar Cloud Vision API
# 3. Crear Service Account
# 4. Descargar JSON de credenciales
# 5. Copiar el contenido completo del JSON aquí (una sola línea)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Cloudflare AI (si AI_PROVIDER=CLOUDFLARE)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI (si AI_PROVIDER=OPENAI - futuro)
OPENAI_API_KEY=

# Internal API Key (para workers/cron)
INTERNAL_API_KEY=

# ── Ingesta externa ──────────────────────────────────────────────
# Secreto HMAC para autenticar worker de Telegram (generar: openssl rand -hex 32)
INGEST_HMAC_SECRET=

# Auto-publicación de posts importados (requiere fuente trusted + confidence >= 0.85 + imagen + ubicación)
INGEST_AUTOPUBLISH=false
AUTOPUBLISH_CONFIDENCE_THRESHOLD=0.85
AUTOPUBLISH_REQUIRE_TRUSTED_SOURCE=true
AUTOPUBLISH_REQUIRE_IMAGE=true
AUTOPUBLISH_REQUIRE_LOCATION=true

# Feature flag para adaptador Facebook Público (best-effort, solo metadatos OG)
FACEBOOK_ADAPTER_ENABLED=false

# ── DB pooling (solo servidor, opcional) ─────────────────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=